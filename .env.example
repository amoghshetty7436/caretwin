# Copy to .env (backend reads CARETWIN_* variables)
CARETWIN_NEO4J_URI=bolt://localhost:7687
CARETWIN_NEO4J_USER=neo4j
CARETWIN_NEO4J_PASSWORD=caretwin-dev
CARETWIN_DATABASE_URL=postgresql+psycopg://caretwin:caretwin@localhost:5432/caretwin
# offline (default, no key) | openai_compat (Groq / Gemini / Ollama / OpenRouter / OpenAI)
CARETWIN_LLM_PROVIDER=offline
CARETWIN_LLM_BASE_URL=https://api.groq.com/openai/v1
CARETWIN_LLM_MODEL=llama-3.3-70b-versatile
CARETWIN_LLM_API_KEY=
